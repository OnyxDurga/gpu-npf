%info
CRC computation

%late_variables

// Click config files names
cpu:FILE={dpdk-crc.click}
gpu-coalescent:FILE={gpu-crc-coalescent.click}
gpu-commlist:FILE={gpu-crc-commlist.click}

gpu-doca:WORKLOAD={2}

%variables

// CPU and GPU
cpu|dpu|gpu-coalescent|gpu-commlist|gpu-doca:RATE=100 //[1-100#1]
cpu|dpu|gpu-coalescent|gpu-commlist|gpu-doca:SIZE=64 //[64*1024]
dpu:NTHREADS=4 //[1*8]
cpu:NTHREADS=4 //[1*16]
gpu-coalescent|gpu-commlist:NTHREADS=4 //[1*4]

// GPU
gpu-commlist:BATCH=1024 //[32*1024]
gpu-coalescent:BATCH=1024 //[32*2048]
gpu-doca:BATCH=2048 //[32*2048]
gpu-coalescent|gpu-commlist:CAPACITY={256}
gpu-coalescent|gpu-commlist:LISTSorQUEUES_PER_CORE=1 //[1*4]
gpu-doca:QUEUES=8 //[1*8]

// Only Coalescent
gpu-coalescent:ZEROCOPY={false} //{true,false}

// Only Commlist
gpu-commlist:MEMPOOL_GPU={true} //{true,false}
gpu-commlist:PERSISTENT_KERNEL={true} //{true,false}

dpu:NDESC=256 //[128*512]


%config
var_lim={RX-RATE-PPS:0-50,RX-RATE-MBPS:0-20,LOSE-RATE:0-1,AVG-LAT:0-6000, GPU-POWER:0-70}
var_names={LOSE-RATE:Loss rate,AVG-LAT:Average Latency,RX-RATE-PPS:Throughput,RX-RATE-MBPS:Throughput,GPU-POWER:GPU Power Consumption,SIZE:Packet size [B],NTHREADS:Number of CPU cores,BATCH: Batch size,CAPACITY: List capacity,LISTSorQUEUES_PER_CORE: Number of lists per core,ZEROCOPY: Zerocopy,MEMPOOL_GPU: Memory pool on GPU,PERSISTENT_KERNEL: Persistent kernels,QUEUES:Number of queues}
var_divider={RX-RATE-PPS:1000000, RX-RATE-MBPS:1000, AVG-LAT:0.000001, GPU-POWER:10}
var_format={RX-RATE-PPS:%dMpps, RX-RATE-MBPS:%dGbps, AVG-LAT:%dµs, GPU-POWER:%dW}
result_add={GPU-POWER}

graph_type=barplot
graph_legend=false
graph_legend_loc=outer upper center
graph_legend_ncol={2}
graph_tick_params={direction:in,which:both,axis:both,grid_linestyle:dotted,bottom:true,top:true,right:true,left:true,grid_color:#444444}
var_grid=true
graph_fillstyle=none
graph_legend_params={fancybox:0,edgecolor:black,framealpha:1.0}
graph_color={1,3,4,4,4,2}

accept_zero={LOSE-RATE,AVG-LAT,RX-GOODPUT-GBPS-PKTGEN}
timeout=60
n_runs=3


%cpu|gpu-coalescent|gpu-commlist:include ../shared/script-workload.npf
%gpu-doca:include ../shared/doca-workload.npf
%dpu:include workload-dpu.npf

%cpu|gpu-coalescent|gpu-commlist|gpu-doca:include ../shared/script-generator.npf
%dpu:include ../shared/script-generator-dpu.npf

%cpu:include dpdk-crc.click
%gpu-coalescent:include gpu-crc-coalescent.click
%gpu-commlist:include gpu-crc-commlist.click

%gpu-doca|gpu-coalescent|gpu-commlist:include ../shared/script-power.npf

%include ../shared/cfg.lua
%dpu:include ../shared/cfg-dpu.lua

%include ../shared/pyexit.npf
